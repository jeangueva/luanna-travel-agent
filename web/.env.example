# ── Build-time (obligatorio para que las páginas se prerendericen con datos) ──
# Los NEXT_PUBLIC_* se inlinean en el bundle durante `npm run build`: ponerlos
# como secreto de Workers NO funciona, tienen que existir al construir.
NEXT_PUBLIC_SITE_URL=https://luanna.app
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_STAY22_AID=
NEXT_PUBLIC_TP_MARKER=

# URLs completas de los widgets, copiadas del panel de Travelpayouts.
# Vacías = el módulo no se renderiza (nunca un hueco roto en la página).
NEXT_PUBLIC_TP_WIDGET_VUELOS=
NEXT_PUBLIC_TP_WIDGET_SEGUROS=
NEXT_PUBLIC_TP_WIDGET_ESIM=

# ── Build-time y runtime ─────────────────────────────────────────────────────
# En el build lo lee de acá; en producción, del secreto de Workers del mismo
# nombre (`npx wrangler secret put DATABASE_URL`). Es el mismo Neon del worker
# de WhatsApp: workers/.dev.vars → DATABASE_URL.
DATABASE_URL=

# ── Solo runtime (secreto de Workers) ────────────────────────────────────────
# Token de la Data API de Travelpayouts: precio "desde" en /api/vuelos. Sin él
# el módulo de vuelos igual ofrece la búsqueda con tu marker. Se saca del panel
# de Travelpayouts (sección de API). `npx wrangler secret put TRAVELPAYOUTS_TOKEN`
TRAVELPAYOUTS_TOKEN=

# Compartido con el worker de ingesta, que lo usa para pedir revalidación al
# aprobar un evento. `npx wrangler secret put REVALIDATE_SECRET`
REVALIDATE_SECRET=

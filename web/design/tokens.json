{
  "$description": "Contrato del sistema de diseño de Luanna. Fuente única: el código genera src/tokens.css desde aquí (npm run tokens) y Figma sincroniza su colección 'Luanna DS' contra este archivo. Los pares de 'contrast' son obligatorios: test/tokens.test.ts falla si alguno baja del mínimo WCAG.",
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#1a1a1a",
      "$description": "Texto principal"
    },
    "ink-soft": {
      "$type": "color",
      "$value": "#5c5c5c",
      "$description": "Texto secundario"
    },
    "ink-muted": {
      "$type": "color",
      "$value": "#6b6b6b",
      "$description": "Notas y ayudas"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Fondo de página"
    },
    "surface-raised": {
      "$type": "color",
      "$value": "#f6f4f1",
      "$description": "Tarjetas sobre el fondo"
    },
    "surface-dark": {
      "$type": "color",
      "$value": "#0a0a0a",
      "$description": "Botón principal y bloques invertidos"
    },
    "on-dark": {
      "$type": "color",
      "$value": "#fafafa",
      "$description": "Texto sobre surface-dark"
    },
    "accent": {
      "$type": "color",
      "$value": "#905831",
      "$description": "Acento cálido (terracota). Cada marca puede reemplazarlo"
    },
    "line": {
      "$type": "color",
      "$value": "#e4e0da",
      "$description": "Bordes y divisores"
    },
    "focus": {
      "$type": "color",
      "$value": "#1d4ed8",
      "$description": "Anillo de foco de teclado"
    },
    "danger": {
      "$type": "color",
      "$value": "#b42318",
      "$description": "Errores"
    },
    "success": {
      "$type": "color",
      "$value": "#067647",
      "$description": "Confirmaciones"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "Geist, -apple-system, BlinkMacSystemFont, sans-serif"
    },
    "display": {
      "$type": "fontFamily",
      "$value": "'Special Elite', Georgia, serif",
      "$description": "Solo para el logotipo"
    }
  },
  "size": {
    "text-xs": {
      "$type": "dimension",
      "$value": "13px",
      "$description": "Mínimo legible: nada por debajo"
    },
    "text-sm": {
      "$type": "dimension",
      "$value": "15px"
    },
    "text-md": {
      "$type": "dimension",
      "$value": "17px",
      "$description": "Cuerpo"
    },
    "text-lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "text-xl": {
      "$type": "dimension",
      "$value": "28px"
    },
    "text-2xl": {
      "$type": "dimension",
      "$value": "40px"
    },
    "text-hero": {
      "$type": "dimension",
      "$value": "68px"
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    },
    "9": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "12px"
    },
    "md": {
      "$type": "dimension",
      "$value": "20px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "32px"
    },
    "card": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Tarjeta de vidrio"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "target": {
    "min": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Tamaño mínimo táctil de cualquier control"
    }
  },
  "contrast": {
    "$description": "Pares [texto, fondo, mínimo]. 4.5 = texto normal AA, 3 = texto grande o elementos de interfaz.",
    "pairs": [
      [
        "ink",
        "surface",
        4.5
      ],
      [
        "ink",
        "surface-raised",
        4.5
      ],
      [
        "ink-soft",
        "surface",
        4.5
      ],
      [
        "ink-muted",
        "surface",
        4.5
      ],
      [
        "ink-muted",
        "surface-raised",
        4.5
      ],
      [
        "on-dark",
        "surface-dark",
        4.5
      ],
      [
        "accent",
        "surface",
        4.5
      ],
      [
        "focus",
        "surface",
        3
      ],
      [
        "danger",
        "surface",
        4.5
      ],
      [
        "success",
        "surface",
        4.5
      ]
    ]
  }
}

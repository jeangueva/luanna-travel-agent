# Shared secret — the Worker sends this as X-API-Key. Generate a long random one.
STAYS_API_KEY=change-me

# Residential rotating proxy. WITHOUT THIS, Airbnb/Booking block the scraper.
# Format: http://user:pass@host:port
# Providers (see README "Where to buy proxies"): Decodo, IPRoyal, Bright Data,
# Oxylabs, Webshare. Example (Decodo rotating residential gateway):
#   PROXY_URL=http://USERNAME:PASSWORD@gate.decodo.com:7000
PROXY_URL=

# Which sites to scrape per request. Each source costs proxy bandwidth.
SOURCES=airbnb,booking

# Optional: cap results per source + in the merged response.
MAX_RESULTS=8

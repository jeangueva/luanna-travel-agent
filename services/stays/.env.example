# Shared secret — the Worker sends this as X-API-Key. Generate a long random one.
STAYS_API_KEY=change-me

# Residential rotating proxy. WITHOUT THIS, Airbnb blocks the scraper.
# Format: http://user:pass@host:port  (from Bright Data / Oxylabs / etc.)
PROXY_URL=

# Optional: cap concurrent Airbnb page loads (protect the proxy budget).
MAX_RESULTS=8
